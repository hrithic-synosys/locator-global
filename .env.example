# Copy to your deployment environment; never copy the UAE deployment config.
NEXT_PUBLIC_SITE_URL=https://locatorglobal.com
SITE_ENV=development
# Set only after confirming separate global-site tracking/chat properties.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TAWK_EMBED_URL=
# Existing form contracts, unchanged. Use test mail/Turnstile settings locally.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
QUOTE_RECIPIENT_EMAIL=
CONTACT_RECIPIENT_EMAIL=
CAREER_RECIPIENT_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,locatorglobal.com,www.locatorglobal.com

# Public CMS reads; server-only. Replace with a reachable hosted API for deployment.
CMS_API_BASE_URL=http://localhost:5000/api/v1
# Server-only webhook bearer secret; generate at least 32 random bytes.
CMS_BLOG_REVALIDATION_SECRET=
